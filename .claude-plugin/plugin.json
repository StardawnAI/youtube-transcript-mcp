{
  "name": "youtube-transcript",
  "version": "2.0.0",
  "description": "YouTube transcripts for videos, playlists and search results. Runs locally, no API key and no account; falls back to a free Cloudflare WARP proxy where YouTube blocks the IP.",
  "author": {
    "name": "Stardawn AI",
    "url": "https://stardawnai.com"
  },
  "homepage": "https://github.com/StardawnAI/youtube-transcript-mcp",
  "repository": "https://github.com/StardawnAI/youtube-transcript-mcp",
  "license": "MIT",
  "keywords": ["youtube", "transcript", "captions", "mcp", "cloudflare-warp"],
  "mcpServers": {
    "youtube-transcript": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/youtube-transcript-mcp.mjs"]
    }
  }
}
