        "endMs": 1467960,
        "start": "00:24:24.480",
        "end": "00:24:27.960"
      },
      {
        "text": "Okay.",
        "startMs": 1480159,
        "endMs": 1483159,
        "start": "00:24:40.159",
        "end": "00:24:43.159"
      },
      {
        "text": "Someone says, \"Where are you from?\"",
        "startMs": 1486159,
        "endMs": 1493120,
        "start": "00:24:46.159",
        "end": "00:24:53.120"
      },
      {
        "text": "I'm from Australia.",
