        "endMs": 1134640,
        "start": "00:18:50.240",
        "end": "00:18:54.640"
      },
      {
        "text": "drink. Love you, girl.\" Oh, I love you,",
        "startMs": 1132000,
        "endMs": 1136240,
        "start": "00:18:52.000",
        "end": "00:18:56.240"
      },
      {
        "text": "too.",
        "startMs": 1134640,
        "endMs": 1137919,
        "start": "00:18:54.640",
        "end": "00:18:57.919"
